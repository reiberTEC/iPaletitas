# Copia este archivo como backend/.env.local (no se sube a git)

# Misma base que creaste en el punto 1. Cambia TU_CONTRASENA.
DATABASE_URL=postgresql://postgres:TU_CONTRASENA@127.0.0.1:5432/ipaletitas

# Secreto para firmar sesiones (cambialo en produccion)
JWT_SECRET=ipaletitas-dev-cambia-esto

# Puerto de la API (Vite reenvia /api/auth aqui)
API_PUERTO=8788

# Origenes permitidos en desarrollo
API_ORIGENES=http://localhost:5173,http://127.0.0.1:5173
