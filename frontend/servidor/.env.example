# Copia este archivo como servidor/.env.local (no se sube a git) y pon tu clave.

# Clave del proveedor del modelo. Nunca la pongas en variables VITE_: esas llegan al navegador.
ASISTENTE_API_KEY=

# Cualquier servicio compatible con "chat completions" de OpenAI.
# OpenAI:      https://api.openai.com/v1/chat/completions   (modelo: gpt-4o-mini)
# Groq:        https://api.groq.com/openai/v1/chat/completions   (modelo: llama-3.3-70b-versatile)
# OpenRouter:  https://openrouter.ai/api/v1/chat/completions   (modelo: openai/gpt-4o-mini, anthropic/claude-3.5-haiku…)
# Ollama local (sin clave): http://localhost:11434/v1/chat/completions   (modelo: llama3.2)
ASISTENTE_URL=https://api.openai.com/v1/chat/completions
ASISTENTE_MODELO=gpt-4o-mini

ASISTENTE_PUERTO=8787
# Orígenes que pueden llamarlo directo (en desarrollo Vite lo reenvía por /api y no hace falta).
ASISTENTE_ORIGENES=http://localhost:5173,http://127.0.0.1:5173
