{
  "name": "ipaletitas-escritorio",
  "productName": "iPaletitas",
  "version": "1.1.0",
  "private": true,
  "description": "iPaletitas para Windows: el panel en su propia ventana, conectado a tu cuenta en línea.",
  "author": "reiberTEC",
  "type": "module",
  "main": "main.mjs",
  "scripts": {
    "preparar": "node preparar.mjs",
    "start": "npm run preparar && electron .",
    "abrir": "electron .",
    "dist": "npm run preparar && electron-builder --win nsis"
  },
  "devDependencies": {
    "electron": "^45.4.1",
    "electron-builder": "^26.18.0"
  },
  "build": {
    "appId": "com.reibertec.ipaletitas",
    "productName": "iPaletitas",
    "copyright": "reiberTEC",
    "directories": {
      "output": "salida"
    },
    "files": [
      "main.mjs",
      "arranque.html",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "recursos",
        "to": "recursos"
      }
    ],
    "win": {
      "target": "nsis",
      "icon": "recursos/icono.png"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "iPaletitas",
      "artifactName": "iPaletitas-Setup-${version}.exe"
    }
  },
  "allowScripts": {
    "electron-winstaller@5.4.0": true,
    "electron@45.4.1": true
  }
}
